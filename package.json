{
  "name": "leodotdev",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "pnpm build && node scripts/check-dist.ts && wrangler deploy",
    "generate-routes": "tsr generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "verify": "pnpm typecheck && pnpm lint && pnpm build",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx}\"",
    "check": "prettier --check \"**/*.{ts,tsx,js,jsx}\"",
    "cf:types": "wrangler types --strict-vars=false",
    "studio": "sanity dev"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/playfair-display": "5.3.0",
    "@portabletext/react": "8.0.1",
    "@portabletext/types": "4.0.2",
    "@sanity/client": "8.15.0",
    "@sanity/image-url": "2.1.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-start": "1.169.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "motion": "14.11.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "5.7.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@sanity/vision": "6.22.0",
    "@tanstack/eslint-config": "0.4.0",
    "@tanstack/router-cli": "1.167.45",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "sanity": "6.22.0",
    "styled-components": "6.6.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "wrangler": "4.151.1"
