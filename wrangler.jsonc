{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "leodotdev",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "upload_source_maps": true,
  // Static files from public/ are served before the Worker runs, by their
  // exact names (no .html stripping, so /resume.html answers 200 as it did on
  // Pages). The binding lets the Worker also serve /resume (src/server.ts).
  "assets": { "binding": "ASSETS", "html_handling": "none" },
  // Production: the apex. www.leo.dev is served elsewhere (it redirects to
  // the apex). The old Cloudflare Pages project `leodotdev` is no longer used.
  "routes": [{ "pattern": "leo.dev/*", "zone_name": "leo.dev" }],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    // Cloudflare Access (admin): the Zero Trust team domain and the
    // "leo.dev admin" application's audience tag. Neither is secret.
    // Until ACCESS_AUD is set, /admin refuses every request in production.
    "ACCESS_TEAM_DOMAIN": "https://leodotdev.cloudflareaccess.com",
    "ACCESS_AUD": "",
  },
  // Site content (projects, experiences, references, books), edited at /admin.
  // `remote: true`: `pnpm dev` reads and writes production too.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "leodotdev",
      "database_id": "9ea1fb7e-3653-4157-9026-4da9c95ac70b",
      "migrations_dir": "drizzle/migrations",
      "remote": true,
    },
  ],
  // Images, served at /images/* by src/server.ts.
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "leodotdev-media", "remote": true },
  ],
}
